API_URL=https://api.cloud.example.com
CONSOLE_URL=https://cloud.example.com
APP_DOMAIN=apps.example.com
API_HOSTNAME=api.cloud.example.com
CONSOLE_HOSTNAME=cloud.example.com
# The installer stores secret files here and protects the directory as root-only.
MINICLOUD_SECRETS_DIR=/var/lib/minicloud/secrets
# Filled from the verified release bundle's images.env; never use tags here.
MINICLOUD_API_IMAGE=
MINICLOUD_DASHBOARD_IMAGE=
MINICLOUD_WORKER_IMAGE=
MINICLOUD_POSTGRES_IMAGE=
MINICLOUD_OPENBAO_IMAGE=
MINICLOUD_KRATOS_IMAGE=
MINICLOUD_CADDY_IMAGE=
# false: operator creates DNS records; true requires a separately configured provider.
MANAGE_DNS_RECORDS=false
MINICLOUD_SOURCE_URL=https://github.com/muniventures/minicloud
