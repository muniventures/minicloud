{
  "Database": {
    "Provider": "Postgres",
    "RunMigrationsOnStartup": true
  },
  "ConnectionStrings": {
    "Minicloud": "Host=localhost;Port=55433;Database=minicloud_dev;Username=minicloud;Password=minicloud"
  },
  "Firebase": {
    "ProjectId": "replace-with-your-firebase-project"
  },
  "Secrets": {
    "EncryptionKey": "local-development-secret-key"
  },
  "OpenBao": {
    "Address": "http://localhost:8200",
    "Token": "dev-only-openbao-token",
    "MountPath": "minicloud-apps",
    "EnvironmentPrefix": "dev"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Telemetry": {
    "LokiBaseAddress": "http://localhost:3100",
    "Environment": "development",
    "UpstreamTimeoutSeconds": 10,
    "MaxConcurrentIngestions": 64
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
