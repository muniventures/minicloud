{
  "Database": {
    "Provider": "Postgres"
  },
  "ConnectionStrings": {
    "Minicloud": "Host=localhost;Database=minicloud;Username=minicloud;Password=minicloud"
  },
  "Firebase": {
    "ProjectId": ""
  },
  "Secrets": {
    "EncryptionKey": ""
  },
  "OpenBao": {
    "Address": "",
    "Token": "",
    "MountPath": "minicloud-apps",
    "EnvironmentPrefix": "prod"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Telemetry": {
    "LokiBaseAddress": "http://loki:3100",
    "Environment": "production",
    "UpstreamTimeoutSeconds": 10,
    "MaxConcurrentIngestions": 64
  },
  "Grafana": {
    "BaseAddress": "http://grafana:3000",
    "ExpectedVersion": "11.6.5",
    "AdminUsername": "admin",
    "OperatorSecretPath": "ops/grafana/server-admin",
    "Audience": "production",
    "ProxyCookieName": "mc_grafana_proxy",
    "QueryGatewayBaseUrl": "",
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
