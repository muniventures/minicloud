<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>3.1.0</Version>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Seed/prepare-host.sh" LogicalName="Minicloud.Cli.Seed.prepare-host.sh" />
    <EmbeddedResource Include="Seed/inspect-host.py" LogicalName="Minicloud.Cli.Seed.inspect-host.py" />
    <ProjectReference Include="..\contracts\Minicloud.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minicloud.Tests" />
    <InternalsVisibleTo Include="Minicloud.Cli.Tests" />
  </ItemGroup>

</Project>
