<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1900;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Polly" Version="7.2.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\common\Minicloud.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\scripts\github-actions\minicloud-deploy\runtime-maintenance.py" Link="scripts\github-actions\minicloud-deploy\runtime-maintenance.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\github-actions\minicloud-deploy\asset-release.py" Link="scripts\github-actions\minicloud-deploy\asset-release.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\github-actions\minicloud-deploy\remote-deploy.sh" Link="scripts\github-actions\minicloud-deploy\remote-deploy.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Minicloud.Worker.Tests" />
  </ItemGroup>

</Project>
