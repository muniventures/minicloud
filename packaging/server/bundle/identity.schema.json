{
  "$id": "https://minicloud.invalid/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minicloud operator identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        },
        "name": {
          "type": "object",
          "properties": {
            "first": { "type": "string", "title": "First name" },
            "last": { "type": "string", "title": "Last name" }
          },
          "additionalProperties": false
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
