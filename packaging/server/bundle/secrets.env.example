# Copy to secrets/kratos.env, restrict it to the installation operator (0600),
# and generate independent random values. Never commit the populated file.
DSN=postgres://kratos:REPLACE_WITH_URL_ENCODED_RANDOM_PASSWORD@postgres:5432/kratos?sslmode=disable
SECRETS_COOKIE=REPLACE_WITH_RANDOM_KEY
SECRETS_CIPHER=REPLACE_WITH_DIFFERENT_RANDOM_KEY
SERVE_PUBLIC_BASE_URL=https://api.example.invalid
SELFSERVICE_DEFAULT_BROWSER_RETURN_URL=https://console.example.invalid/
SELFSERVICE_ALLOWED_RETURN_URLS=https://console.example.invalid
SELFSERVICE_FLOWS_LOGIN_UI_URL=https://console.example.invalid/auth/login
SELFSERVICE_FLOWS_SETTINGS_UI_URL=https://console.example.invalid/auth/settings
SELFSERVICE_FLOWS_ERROR_UI_URL=https://console.example.invalid/auth/error
